# EnvironmentFile for the pflex_exporter systemd unit.
# Supplies cluster secrets referenced as ${VAR} in config.yaml.
#
# Install:  /etc/pflex_exporter/pflex_exporter.env   (chmod 0600, chown root:pflex)

PFLEX1_PASSWORD=change-me
# PFLEX2_PASSWORD=change-me

# Skip TLS certificate verification (INSECURE — self-signed certs on a trusted network
# only). Only takes effect if config.yaml's insecureSkipVerify is switched to a ${VAR}.
# PFLEX1_SKIP_CERTIFICATE=false
# PFLEX2_SKIP_CERTIFICATE=false
